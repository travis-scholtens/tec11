load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

rust_shared_library(
    name = "tec11_wasm_lib",
    srcs = [
        "src/climate_session.rs",
        "src/erosion_session.rs",
        "src/grid_session.rs",
        "src/language_session.rs",
        "src/lib.rs",
        "src/lifeforms_session.rs",
        "src/mesh.rs",
        "src/move_session.rs",
        "src/pangea_session.rs",
        "src/population_session.rs",
        "src/prehistory_session.rs",
        "src/racination_session.rs",
        "src/rivers_session.rs",
        "src/split_session.rs",
        "src/tectonics_session.rs",
    ],
    edition = "2021",
    deps = [
        "//crates/tec11-climate:tec11_climate",
        "//crates/tec11-geology:tec11_geology",
        "//crates/tec11-math-grid:tec11_math_grid",
        "//crates/tec11-proto:tec11_proto",
        "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen",
    ],
)

rust_wasm_bindgen(
    name = "tec11_wasm",
    target = "web",
    wasm_file = ":tec11_wasm_lib",
    visibility = ["//visibility:public"],
)
