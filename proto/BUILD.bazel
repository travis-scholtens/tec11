load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library_group")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library", "rust_prost_toolchain")

package(default_visibility = ["//visibility:public"])

rust_library_group(
    name = "prost_runtime",
    deps = [
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_prost_toolchain(
    name = "prost_only_toolchain_impl",
    compile_well_known_types = True,
    prost_plugin = "@rules_rust_prost//private/3rdparty/crates:protoc-gen-prost__protoc-gen-prost",
    prost_plugin_flag = "--plugin=protoc-gen-prost=%s",
    prost_runtime = ":prost_runtime",
    prost_types = "@rules_rust_prost//private/3rdparty/crates:prost-types",
    tonic_plugin_flag = "",
)

toolchain(
    name = "prost_only_toolchain",
    toolchain = ":prost_only_toolchain_impl",
    toolchain_type = "@rules_rust_prost//:toolchain_type",
)

proto_library(
    name = "tec11_schema_proto",
    srcs = ["tec11.proto"],
)

rust_prost_library(
    name = "tec11_rs_proto",
    proto = ":tec11_schema_proto",
)
